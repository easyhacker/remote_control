<?xml version="1.0"?>
<!-- Kinematic outline of the Unity demo arm (same joint names and limits), for the ROS 2 bridge examples. -->
<robot name="demo_arm">
  <link name="base_link"/>
  <link name="yaw_link"/>
  <link name="upper_arm"/>
  <link name="forearm"/>
  <link name="wrist_link"/>
  <link name="finger"/>

  <joint name="shoulder_yaw" type="revolute">
    <parent link="base_link"/><child link="yaw_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" velocity="2.0" effort="50"/>
  </joint>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="yaw_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-1.745" upper="1.745" velocity="2.0" effort="50"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 1 0"/>
    <limit lower="-2.443" upper="2.443" velocity="2.0" effort="30"/>
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="forearm"/><child link="wrist_link"/>
    <origin xyz="0 0 0.4"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" velocity="2.0" effort="10"/>
  </joint>
  <joint name="gripper" type="prismatic">
    <parent link="wrist_link"/><child link="finger"/>
    <origin xyz="0 0 0.05"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.05" velocity="0.1" effort="20"/>
  </joint>
</robot>
